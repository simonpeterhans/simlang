//(name,                                  level,    description,                               format)

// Notes.
X( cNoteMessage,                          cNote,    "Note.",                                   "{}" )
X( cPreviousDefinition,                   cNote,    "Previous definition.",                    "Previous definition is here." )
X( cSymbolDeclaredHere,                   cNote,    "Symbol declared here.",                   "Symbol '{}' is declared here." )
X( cTemplateDeclaredHere,                 cNote,    "Template declared here.",                 "Template '{}' is declared here." )
X( cFieldDeclaredHere,                    cNote,    "Field declared here.",                    "Field '{}' is declared here." )
X( cInitializerDeclaredHere,              cNote,    "Initializer declared here.",              "Initializer is declared here." )
X( cInterfaceMethodDeclaredHere,          cNote,    "Interface method declared here.",         "Required method '{}' is declared here." )

// Hints.
X( cHintMessage,                          cHint,    "Hint.",                                   "{}" )
X( cAddExportSpecifierHint,               cHint,    "Export symbol.",                          "Add 'export' to the declaration if this symbol should be visible to imports." )
X( cAddImplSpecifierHint,                 cHint,    "Add impl specifier.",                     "Add 'impl' to the method if it is intended to satisfy this interface method." )
X( cClassFieldInitializationHint,         cHint,    "Initialize class fields.",                "Initialize missing class fields at the start of 'init', or give them declaration defaults." )

// Source and module.
X( cFailedToOpenSource,                   cError,   "Failed to open source.",                  "Source '{}' could not be opened for reading." )
X( cFailedToReadSource,                   cError,   "Failed to read source.",                  "Source '{}' could not be read." )
X( cSourceTooLong,                        cError,   "Sources too long.",                       "Loading '{}' would exceed the combined source length (32 bits)." )
X( cModuleNotFound,                       cError,   "Module not found.",                       "Cannot resolve module '{}'." )
X( cAmbiguousModuleRoot,                  cError,   "Ambiguous module root.",                  "Both '{}' and '{}' exist for module '{}'." )

// Tokenizer.
X( cUnterminatedBlockComment,             cError,   "Unterminated block comment.",             "Missing '*/' before end of file." )
X( cInvalidEscapeCharacter,               cError,   "Invalid escape character.",               "Invalid escape character '{}'." )
X( cUnterminatedStringLiteral,            cError,   "Unterminated string literal.",            "Missing \" after string." )
X( cNewlineInStringLiteral,               cError,   "Newline in string literal.",              "Unescaped newline in string literal." )
X( cInvalidHexCharacter,                  cError,   "Illegal hexadecimal character.",          "Invalid hexadecimal character '{}'." )
X( cInvalidBinaryCharacter,               cError,   "Illegal binary character.",               "Invalid binary character '{}'." )
X( cLeadingZeroInteger,                   cError,   "Illegal integer literal.",                "Non-zero integer literals cannot start with a leading zero." )
X( cFloatLiteralMissingFraction,          cError,   "Illegal float literal.",                  "A float cannot end with a '.' character." )
X( cMalformedIntLiteral,                  cError,   "Invalid integer literal.",                "'{}' is not a valid integer literal." )
X( cMalformedFloatLiteral,                cError,   "Invalid float literal.",                  "'{}' is not a valid float literal." )
X( cTokenTooLong,                         cError,   "Token too long.",                         "Token length {} exceeds the maximum token length of {}." )
X( cIllegalCharacter,                     cError,   "Illegal character.",                      "Found illegal character '{}'." )

// Parser.
X( cUnexpectedToken,                      cError,   "Unexpected token.",                       "Expected {} but got '{}'." )
X( cMissingClosingDelim,                  cError,   "Expected closing delimiter.",             "Expected closing '{}' but got '{}'." )
X( cMissingSemicolon,                     cError,   "Missing semicolon.",                      "Missing ';' before '{}'." )
X( cInvalidIntLiteral,                    cError,   "Illegal integer literal.",                "'{}' is not a valid integer." )
X( cIntLiteralOutOfRange,                 cError,   "Integer literal overflow.",               "{} does not fit into a 32 bit integer." )
X( cInvalidFloatLiteral,                  cError,   "Invalid float literal.",                  "'{}' is not a valid float." )
X( cFloatLiteralOutOfRange,               cError,   "Float literal overflow.",                 "{} does not fit into a 32 bit float." )
X( cIdentifierTooLong,                    cError,   "Identifier too long.",                    "'{}' exceeds the maximum identifier length of {}." )
X( cStringLiteralTooLong,                 cError,   "String literal too long.",                "String literal has {} byte(s), but the compiler supports at most {}." )
X( cInvalidStatementStart,                cError,   "Invalid statement starter.",              "'{}' is not a valid statement starter." )
X( cCaseOutsideSwitch,                    cError,   "'case' outside switch.",                  "'case' labels can only appear inside a switch statement." )
X( cDefaultOutsideSwitch,                 cError,   "'default' outside switch.",               "'default' labels can only appear inside a switch statement." )
X( cInvalidDeclarationStart,              cError,   "Invalid declaration starter.",            "'{}' is not a valid declaration starter." )
X( cDuplicateTemplateParameter,           cError,   "Duplicate template parameter.",           "Template parameter '{}' is already declared." )
X( cDuplicateExportSpecifier,             cWarning, "Duplicate 'export' specifier.",           "'export' specified multiple times; duplicate ignored." )
X( cExportOnNonTopLevel,                  cError,   "Invalid export.",                         "'export' is only allowed on top-level declarations." )
X( cInvalidExportTarget,                  cError,   "Invalid export.",                         "'export' cannot be applied to '{}' declarations." )
X( cDuplicatePrivateSpecifier,            cWarning, "Duplicate 'private' specifier.",          "'private' specified multiple times; duplicate ignored." )
X( cPrivateInterfaceMember,               cError,   "Invalid private member.",                 "Interface members cannot be private." )
X( cDuplicateImplSpecifier,               cWarning, "Duplicate 'impl' specifier.",             "'impl' specified multiple times; duplicate ignored." )
X( cInvalidImplTarget,                    cError,   "Invalid impl.",                           "'impl' can only be applied to class methods." )
X( cInvalidImplClause,                    cError,   "Invalid impl.",                           "'impl' interface clauses are only allowed on class declarations." )

// Declaration, import, resolution.
X( cInvalidTypeDeclarationScope,          cError,   "Type declaration in invalid scope.",      "Struct or class '{}' must be declared on the top level." )
X( cInvalidFunctionDeclarationScope,      cError,   "Function declaration in invalid scope.",  "Function '{}' must be declared as a method in a type or on the top level." )
X( cSymbolAlreadyDefined,                 cError,   "Symbol already defined.",                 "Symbol '{}' is already defined in this scope." )
X( cImportedSymbolNotFound,               cError,   "Imported symbol not found.",              "Module does not define symbol '{}'." )
X( cImportedSymbolNotExported,            cError,   "Imported symbol is private.",             "Symbol '{}' is defined but not exported by the imported module." )
X( cUndefinedIdentifier,                  cError,   "Undefined identifier.",                   "Identifier '{}' is not defined in this scope." )
X( cThisOutsideMethod,                    cError,   "'this' outside method.",                  "Cannot use 'this' outside of a method context." )
X( cInvalidModuleAccess,                  cError,   "Invalid module access.",                  "Module access requires identifier expressions." )
X( cNotAModule,                           cError,   "Identifier is not a module.",             "Identifier '{}' is not a module." )
X( cSymbolIsNotType,                      cError,   "Symbol is not a type.",                   "Symbol '{}' cannot be used as a type." )
X( cTemplateArgumentsOnNonTemplateType,   cError,   "Type is not a template.",                 "Type '{}' does not accept template arguments." )
X( cWrongTemplateArgumentCount,           cError,   "Wrong template argument count.",          "Template expects {} argument(s) but got {}." )
X( cTemplateInstanceNameTooLong,          cError,   "Template instance name too long.",        "Template instance name '{}' is {} byte(s), but the compiler supports at most {}." )
X( cCircularTypeDependency,               cError,   "Circular type dependency.",               "Type resolution for '{}' would create a circular dependency." )

// Type checking.
X( cTypeMismatch,                         cError,   "Type mismatch.",                          "Expected type '{}' but got '{}'." )
X( cCannotInferType,                      cError,   "Cannot infer type.",                      "Cannot infer type for variable '{}'. Provide an explicit type or an initializer with a concrete type." )
X( cInvalidTypeInContext,                 cError,   "Invalid type.",                           "Type '{}' cannot be used as {}." )
X( cInvalidCast,                          cError,   "Invalid cast.",                           "Cannot cast value of type '{}' to '{}'." )
X( cInvalidFloatToIntCast,                cError,   "Invalid float-to-int cast.",              "Float value cannot be represented as int." )
X( cVariableInitializerRequired,          cError,   "Initializer missing.",                    "Initializer for variable '{}' is required." )
X( cGlobalInitializerNotConstExpr,        cError,   "Global initializer not constexpr.",       "Initializer for global '{}' must be a constexpr expression." )
X( cInvalidConstType,                     cError,   "Invalid const type.",                      "Type '{}' cannot be declared const. Const declarations require int, float, bool, or string." )
X( cNotAnLValue,                          cError,   "Not an lvalue.",                          "Expression cannot be assigned to." )
X( cNotMutable,                           cError,   "Not mutable.",                            "Cannot assign to immutable value." )
X( cInvalidAssignmentOperands,            cError,   "Invalid assignment operands.",            "Operator '{}' cannot assign value of type '{}' to '{}'." )
X( cInvalidOperandType,                   cError,   "Invalid operand type.",                   "Operator '{}' cannot be applied to type '{}'." )
X( cInvalidBinaryOperands,                cError,   "Invalid binary operands.",                "Operator '{}' cannot be applied to types '{}' and '{}'." )
X( cDivisionByZero,                       cError,   "Division by zero.",                       "Operator '{}' cannot use zero as the right operand." )
X( cShiftCountOutOfRange,                 cError,   "Shift count out of range.",               "Shift count for operator '{}' must be between 0 and 31, but got {}." )
X( cNotPrintable,                         cError,   "Not printable.",                          "Expression of type '{}' cannot be formatted or printed." )
X( cNotAFunction,                         cError,   "Not a function.",                         "Expression is not callable." )
X( cWrongArgumentCount,                   cError,   "Wrong argument count.",                   "Function expects {} argument(s) but got {}." )
X( cInvalidArgumentType,                  cError,   "Invalid argument type.",                  "Argument {} expects type '{}' but got '{}'." )
X( cMissingInOutArgument,                 cError,   "Missing inout marker.",                   "Argument {} must be passed with 'inout'." )
X( cUnexpectedInOutArgument,              cError,   "Unexpected inout marker.",                "Argument {} is not an inout parameter." )
X( cInOutBindingFailed,                   cError,   "Inout binding failed.",                   "Cannot bind inout argument to non-lvalue or mismatched type." )
X( cInvalidMemberReceiver,                cError,   "Invalid member access.",                  "Type '{}' cannot be used for member access (expected struct, class, or interface)." )
X( cMemberNotFound,                       cError,   "Member not found.",                       "Type '{}' has no member named '{}'." )
X( cPrivateMemberAccess,                  cError,   "Private member access.",                  "Member '{}' of type '{}' is private to its declaring module." )
X( cMethodAccessWithoutCall,              cError,   "Method access without calling.",          "Member '{}' of type '{}' is a method and must be called when accessed." )
X( cInitializerAccess,                    cError,   "Invalid initializer access.",             "Init methods can only be called by class construction." )
X( cMissingReturnStatement,               cError,   "Missing return statement.",               "Function '{}' must end with a return statement because it returns '{}'." )
X( cCaseLabelNotConstexpr,                cError,   "Case label not constexpr.",               "Case labels must be constant integer expressions." )
X( cDuplicateCaseLabel,                   cError,   "Duplicate case label.",                   "Case label '{}' is already used in this switch." )
X( cDuplicateDefaultLabel,                cError,   "Duplicate default label.",                "A switch statement can only have one default label." )
X( cBreakOutsideLoopOrSwitch,             cError,   "'break' outside loop or switch.",         "'break' can only appear inside a loop or switch statement." )
X( cContinueOutsideLoop,                  cError,   "'continue' outside loop.",                "'continue' can only appear inside a loop statement." )

// Lists, construction, interfaces.
X( cNotIndexable,                         cError,   "Not indexable.",                          "Type '{}' is not indexable." )
X( cInvalidIndexType,                     cError,   "Invalid index type.",                     "Index must be of type 'int', not '{}'." )
X( cInvalidNewExpression,                 cError,   "Invalid new expression.",                 "Cannot use 'new' with type '{}'." )
X( cInvalidMakeExpression,                cError,   "Invalid make expression.",                "Cannot use 'make' with type '{}'." )
X( cMissingClassInitializer,              cError,   "Missing class initializer.",              "Class '{}' must declare an init method." )
X( cInitOnNonClass,                       cError,   "Invalid init declaration.",               "Init declarations are only allowed in classes." )
X( cDuplicateFieldInitializer,            cError,   "Duplicate field initializer.",            "Field '{}' is initialized more than once." )
X( cMissingFieldInitializer,              cError,   "Missing field initializer.",              "Field '{}' must be initialized." )
X( cNotAnInterfaceType,                   cError,   "Not an interface.",                       "Type '{}' is not an interface type." )
X( cStructInterfaceImplementation,        cError,   "Invalid interface declaration.",          "Struct '{}' cannot declare interface '{}'. Interfaces are currently restricted to classes." )
X( cPrivateImplMethod,                    cError,   "Invalid impl.",                           "Private method '{}' cannot be marked 'impl'." )
X( cInvalidImplMethod,                    cError,   "Invalid impl method.",                    "Method '{}' is marked 'impl' but does not match any declared interface method." )
X( cInterfaceMethodMissing,               cError,   "Interface method missing.",               "Type '{}' declares interface '{}' but does not define method '{}'." )
X( cPrivateInterfaceImplementation,       cError,   "Private interface method.",               "Private method '{}' cannot satisfy interface '{}'." )
X( cInterfaceMethodTypeMismatch,          cError,   "Interface method mismatch.",              "Method '{}' for interface '{}' has type '{}', but implementation has type '{}'." )
X( cInterfaceMethodMissingImpl,           cError,   "Missing impl specifier.",                 "Method '{}' satisfies interface '{}' but is not marked 'impl'." )

// Validation and limits.
X( cMissingMainFunction,                  cError,   "Missing entry point.",                    "Program entry point 'main' was not found." )
X( cDuplicateMainFunction,                cError,   "Duplicate main entry point.",             "Program entry point 'main' can only be defined once." )
X( cInvalidMainSignature,                 cError,   "Invalid entry point.",                    "Program entry point 'main' must be a top-level function with no parameters and return type 'void'." )
X( cRecursiveValueType,                   cError,   "Recursive value type.",                   "Type '{}' creates a recursive by-value struct layout. Use a class or list for recursive references." )
X( cEmptyStruct,                          cError,   "Empty struct.",                           "Struct '{}' must declare at least one stored field." )
X( cTooManyTypes,                         cError,   "Too many types.",                         "Type '{}' would need type ID {}, but the VM supports IDs up to {}." )
X( cTooManyInterfaceMethods,              cError,   "Too many interface methods.",             "Method '{}' would need interface method slot {}, but the VM supports slots up to {}." )
X( cTooManyInterfaceCalls,                cError,   "Too many interface calls.",               "Interface call would need dispatch signature index {}, but the VM supports indices up to {}." )
X( cTypeLayoutTooLarge,                   cError,   "Type layout too large.",                  "Type '{}' requires {} word(s), but the type layout table supports at most {}." )
X( cTypeLayoutRefOffsetTableTooLarge,     cError,   "Type layout table too large.",            "Type '{}' would need reference offset table index {}, but the type layout table supports indices up to {}." )
X( cTooManyGlobals,                       cError,   "Too many globals.",                       "Global '{}' would require global word index {}, but the VM supports indices up to {}." )
X( cGlobalValueTooLarge,                  cError,   "Global value too large.",                 "Global '{}' requires {} word(s), but global load/store operations support at most {}." )
X( cFunctionFrameTooLarge,                cError,   "Function frame too large.",               "Function frame requires {} {} word(s), but the VM supports at most {}." )
X( cBytecodeTooLarge,                     cError,   "Bytecode too large.",                     "Bytecode would need {} byte(s), but the VM supports bytecode up to {} byte(s)." )
